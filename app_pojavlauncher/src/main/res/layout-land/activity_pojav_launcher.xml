<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ImageView
        android:id="@+id/swiftmod_logo"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:contentDescription="@string/app_short_name"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintBottom_toBottomOf="@id/header_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/swiftmod_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_7sdp"
        android:text="@string/app_short_name"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/_14ssp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/swiftmod_subtitle"
        app:layout_constraintStart_toEndOf="@id/swiftmod_logo"/>

    <TextView
        android:id="@+id/swiftmod_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minecraft Launcher"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_8ssp"
        app:layout_constraintBottom_toBottomOf="@id/swiftmod_logo"
        app:layout_constraintStart_toStartOf="@id/swiftmod_title"/>

    <EditText
        android:id="@+id/swiftmod_search"
        android:layout_width="0dp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:background="@drawable/swiftmod_search"
        android:hint="Search mods, packs, or projects..."
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:singleLine="true"
        android:textColor="@color/primary_text"
        android:textColorHint="@color/secondary_text"
        android:textSize="@dimen/_9ssp"
        app:layout_constraintBottom_toBottomOf="@id/header_divider"
        app:layout_constraintEnd_toStartOf="@id/account_spinner"
        app:layout_constraintStart_toEndOf="@id/swiftmod_title"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.kdt.mcgui.AccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="@dimen/_92sdp"
        android:layout_height="@dimen/_38sdp"
        android:dropDownWidth="wrap_content"
        android:dropDownVerticalOffset="@dimen/_38sdp"
        app:layout_constraintEnd_toStartOf="@id/setting_button"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/ic_px_sliders"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/header_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/swiftmod_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/swiftmod_logo"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:name="net.kdt.pojavlaunch.fragments.MainMenuFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/progress_layout"
        app:layout_constraintTop_toBottomOf="@id/header_divider"/>

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>